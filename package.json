{
  "name": "st-marien-light-and-shadow",
  "version": "0.51.0",
  "private": true,
  "type": "module",
  "description": "Interaktives 3D-Lichtmodell von St. Marien zu Lübeck: Kirche als Sonnenuhr, Sonnenuhr am Südturm, Astronomische Uhr, Licht und Schatten.",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build --mode web",
    "build:offline": "vite build --mode offline",
    "build": "npm run build:web && npm run build:offline",
    "preview": "vite preview --outDir web --port 8000",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:test": "vite build --mode uitest",
    "test:astro": "node tests/astro/dump.mjs && python tests/astro/check.py"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "three": "0.128.0",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
